@page "/OffendersPage"
@using static ACS_BlazorView.Pages.Index;
@using ACS_BlazorView.Data;
@inject SessionManager manager;
@using LibraryBD.BD;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@inject ProtectedSessionStorage storage
@inject HttpClient httpclient;
@inject SessionManager sessions;
@inject AuthenticationStateProvider auth;
@inject NavigationManager nav;
<style>
    .container-fluid {
        background-color: #ff7300;
    }

    .navbar {
        background-color: #ff7300;
        padding-top: 10px;
    }

    #table {
        border: 1px solid #dddddd;
        border-collapse: collapse;
        width: 100%;
    }

        #table th {
            font-weight: bold;
            padding: 10px;
            background: #efefef;
            border: 1px solid #dddddd;
            text-align: center;
            vertical-align: middle;
        }

        #table td {
            border: 1px solid #dddddd;
            padding: 10px;
            text-align: center;
            vertical-align: middle;
        }

        /* Нечетные строки */
        #table tbody tr:nth-child(odd) {
            background: #fff;
        }

        /* Четные строки */
        #table tbody tr:nth-child(even) {
            background: #F7F7F7;
        }
</style>
<PageTitle>Нарушители</PageTitle>
<CascadingAuthenticationState>
    <AuthorizeView>
        <nav class="navbar sticky-top">
            <div class="container-fluid">
                <h5 style="font-size: 130%" class="fw-bold text-white">Нарушители</h5>
                <button type="button" class="btn btn-primary">Кнопка</button>

            </div>
        </nav>
        <table id="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Имя</th>
                    <th>Должность</th>
                    <th>W26</th>
                    <th width=20%>Время</th>
                    <th width=20%>Статус доклада о нарушении</th>
                </tr>
            </thead>

            <tbody>
                @try
                {
                    @foreach (Offender offender in @Offenders)
                    {
                        <tr>
                            <td>@Offenders.IndexOf(offender)</td>
                            <td>@offender.Name</td>
                            <td>@offender.Position</td>
                            <td>@offender.W26</td>
                            <td>@offender.Time</td>
                            @if (offender.SendOrNot == 0)
                            {
                                var s = Convert.ToString(offender.SendOrNot);
                                s = "Не отправлено";
                                <td>@s</td>
                            }
                            else
                            {
                                var s = Convert.ToString(offender.SendOrNot);
                                s = "Отправлено";
                                <td>@s</td>
                            }

                        </tr>
                    }
                }
                catch{}
            </tbody>
        </table>
    </AuthorizeView>
</CascadingAuthenticationState>
@code {
    private List<Offender> Offenders = new();
    private volatile static bool workCycle = new();

    protected override async Task OnAfterRenderAsync(bool firstrender)
    {
        Thread timer = new Thread(() => Timer());
        workCycle = true;
        timer.Start();

        nav.LocationChanged += (obj, lcea) =>
        {
            if (lcea.Location != "https://10.10.1.7:7151/OffendersPage")
            {
                workCycle = false;
            }
        };

        await base.OnInitializedAsync();
    }
    private async Task Timer()
    {
        while (workCycle == true)
        {
            Offenders = await httpclient.GetFromJsonAsync<List<Offender>>("Offenders/GetOffenders");
            Offenders.Reverse();
            Thread.Sleep(1000);
        }
    }
}
