@page "/CyclesPage"
@using static ACS_BlazorView.Pages.Index;
@using ACS_BlazorView.Data;
@inject SessionManager manager;
@using LibraryBD.BD;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@using System.Text.Json;
@using System.Text.Json.Serialization;
@inject ProtectedSessionStorage storage
@inject HttpClient httpclient;
@inject SessionManager sessions;
@inject AuthenticationStateProvider auth;
@inject NavigationManager nav;
<style>
    .container-fluid {
        background-color: #ff7300;
    }

    .navbar {
        background-color: #ff7300;
        padding-top: 10px;
    }

    #table {
        border: 1px solid #dddddd;
        border-collapse: collapse;
        width: 100%;
    }

        #table th {
            font-weight: bold;
            padding: 10px;
            background: #efefef;
            border: 1px solid #dddddd;
            text-align: center;
            vertical-align: middle;
        }

        #table td {
            border: 1px solid #dddddd;
            padding: 10px;
            text-align: center;
            vertical-align: middle;
        }

        /* Нечетные строки */
        #table tbody tr:nth-child(odd) {
            background: #fff;
        }

        /* Четные строки */
        #table tbody tr:nth-child(even) {
            background: #F7F7F7;
        }
</style>
<PageTitle>Циклы</PageTitle>
<CascadingAuthenticationState>
    <AuthorizeView>
        <nav class="navbar sticky-top">
            <div class="container-fluid">
                <h5 style="font-size: 130%" class="fw-bold text-white">Циклы</h5>
                <button type="button" class="btn btn-primary">Кнопка</button>

            </div>
        </nav>
        <table id="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th scope="col">ФИО</th>
                    <th scope="col">Должность</th>
                    <th scope="col">W26</th>
                    <th scope="col">Вход</th>
                    <th scope="col">Выход</th>
                    <th scope="col">Пробыл на базе</th>
                </tr>
            </thead>

            <tbody>
                @try
                {
                    @foreach (ACS_API.DTO.Cycle cycles in @Cycles)
                    {
                        <tr>
                            <td>@Cycles.IndexOf(cycles)</td>
                            <td>@cycles.Fio</td>
                            <td>@cycles.Position</td>
                            <td>@cycles.W26</td>
                            <td>@cycles.TimeP1</td>
                            <td>@cycles.TimeP2</td>
                            <td>@cycles.Delta</td>
                        </tr>
                    }
                }
                catch
                {

                }
            </tbody>
        </table>
    </AuthorizeView>
</CascadingAuthenticationState>
@code {
    private List<ACS_API.DTO.Cycle> Cycles = new();
    private volatile static bool workCycle = new();


    protected override async Task OnAfterRenderAsync(bool firstrender)
    {
        Thread timer = new Thread(() => Timer());
        workCycle = true;
        timer.Start();


        nav.LocationChanged += (obj, lcea) =>
        {
            if (lcea.Location != "https://10.10.1.7:7151/CyclesPage")
            {
                workCycle = false;
            }
        };

        await base.OnInitializedAsync();
    }

    private async Task Timer()
    {


        while (workCycle == true)
        {

            Cycles = await httpclient.GetFromJsonAsync<List<ACS_API.DTO.Cycle>>("Cycles/GetCycles");

            Thread.Sleep(1000);
        }
        
    }
}

