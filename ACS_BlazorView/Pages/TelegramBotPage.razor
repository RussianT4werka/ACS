@page "/TelegramBotPage"
@using static ACS_BlazorView.Pages.Index;
@using ACS_BlazorView.Data;
@inject SessionManager manager;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@inject ProtectedSessionStorage storage
@inject HttpClient httpclient;
@inject SessionManager sessions;
@inject AuthenticationStateProvider auth;
@inject NavigationManager nav;
<style>
    .container-fluid {
        background-color: #ff7300;
    }

    .navbar {
        background-color: #ff7300;
        padding-top:10px;
    }
</style>
<PageTitle>Настройки рассылки</PageTitle>
<CascadingAuthenticationState>
<AuthorizeView>
    <nav class="navbar sticky-top">
        <div class="container-fluid">
        <h5 style="font-size: 130%" class="fw-bold text-white">Список подписчиков</h5>
                <a class="btn btn-primary" href="/TelegramLogsPage">Логи *в разработке*</a>

        </div>
    </nav>
        <table class="table">
            <thead>
                <tr>
                    <th>ChatID</th>
                    <th>Имя</th>
                    <th>Фамилия</th>
                    <th>Username</th>
                    <th>Уведомления</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (Subscriber sub in @Subscribers)
                {
                    <tr>
                        <td>@sub.ChatId</td>
                        <td>@sub.Name</td>
                        <td>@sub.Surname</td>
                        <td>@sub.Username</td>
                        <td>
                            <div class="form-check form-switch" @onclick="@(() => SubscribeOrNot(sub))">
                                @if (sub.SubscribeOrNot == 0)
                                {
                                    <input class="form-check-input btn-lg btn-block" type="checkbox" id="flexSwitchCheckDefault">
                                    
                                }
                                else if (sub.SubscribeOrNot == 1)
                                {
                                    <input class="form-check-input btn-lg btn-block" type="checkbox" id="flexSwitchCheckDefault" checked>
                                }
                            </div>
                        </td>
                        <td>
                            <a class="btn btn-danger" @onclick="@(() => DeleteSub(sub))">🗑️</a>
                        </td>
                    </tr>
                }
            </tbody>    
        </table>
</AuthorizeView>
</CascadingAuthenticationState>


@code {
    UserData userData = new();
    string message = "";

    private List<Subscriber> Subscribers = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Thread timer = new Thread(() => Timer());
        timer.Start();

        await base.OnInitializedAsync();
    }
    private async Task Timer()
    {
        while (true)
        {
            Subscribers = await httpclient.GetFromJsonAsync<List<Subscriber>>("SubscriberTelegramBots/GetListSubscribers");
            Thread.Sleep(1000);
        }
    }

    async Task SubscribeOrNot(Subscriber sub)
    {
        var answer = await httpclient.PostAsJsonAsync("SubscriberTelegramBots/SubscribeOrNot", sub);
    }

    async Task DeleteSub(Subscriber sub)
    {
        var answer = await httpclient.PostAsJsonAsync("SubscriberTelegramBots/DelSubscriber", sub);
    }

    public class Subscriber
    {
        public string? ChatId { get; set; }

        public string? Name { get; set; }

        public string? Surname { get; set; }

        public string? Username { get; set; }

        public byte? SubscribeOrNot { get; set; }
    }
    
    
}

