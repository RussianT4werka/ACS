@page "/TelegramLogsPage"
@using static ACS_BlazorView.Pages.Index;
@using ACS_BlazorView.Data;
@inject SessionManager manager;
@using LibraryBD.BD;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@inject ProtectedSessionStorage storage
@inject HttpClient httpclient;
@inject SessionManager sessions;
@inject AuthenticationStateProvider auth;
@inject NavigationManager nav;
<style>
    .container-fluid {
        background-color: #ff7300;
    }

    .navbar {
        background-color: #ff7300;
        padding-top: 10px;
    }

    #table {
        border: 1px solid #dddddd;
        border-collapse: collapse;
        width: 100%;
    }

        #table th {
            font-weight: bold;
            padding: 10px;
            background: #efefef;
            border: 1px solid #dddddd;
            text-align: center;
            vertical-align: middle;
        }

        #table td {
            border: 1px solid #dddddd;
            padding: 10px;
            text-align: center;
            vertical-align: middle;
        }

        /* Нечетные строки */
        #table tbody tr:nth-child(odd) {
            background: #fff;
        }

        /* Четные строки */
        #table tbody tr:nth-child(even) {
            background: #F7F7F7;
        }
</style>
<PageTitle>Настройки рассылки</PageTitle>
<CascadingAuthenticationState>
    <AuthorizeView>
        <nav class="navbar sticky-top">
            <div class="container-fluid">
                <h5 style="font-size: 130%" class="fw-bold text-white">Логи</h5>
                <a @onclick="@(() => DeleteLogs())" class="btn btn-danger">Очистить логи</a>

            </div>
        </nav>
        <table id="table">
            <thead>
                <tr>
                    <th>Текст лога</th>
                    <th width=10%>Дата и время</th>
                </tr>
            </thead>

            <tbody>
                @try
                {
                    @foreach (Log log in @Logs)
                    {
                        <tr>
                            <td style="text-align:left">@log.Title</td>
                            <td>@log.DateTime</td>
                        </tr>
                    }
                }
                catch
                {
                    
                }
            </tbody>
        </table>
    </AuthorizeView>
</CascadingAuthenticationState>
@code {

    private List<Log> Logs = new();
    private volatile static bool workCycle = new();

    protected override async Task OnAfterRenderAsync(bool firstrender)
    {
        Thread timer = new Thread(() => Timer());
        workCycle = true;
        timer.Start();

        await base.OnInitializedAsync();
    }

    private async Task Timer()
    {
        while (workCycle == true)
        {
            Logs = await httpclient.GetFromJsonAsync<List<Log>>("Logs/GetListLogs");
            Logs.Reverse();
            Thread.Sleep(1000);
        }
    }

    async Task DeleteLogs()
    {
        var answer = await httpclient.PostAsJsonAsync("Logs/DeleteListLogs", Logs);
    }
}
