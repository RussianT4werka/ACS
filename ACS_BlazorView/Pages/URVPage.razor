@page "/URVPage"
@using static ACS_BlazorView.Pages.Index;
@using ACS_BlazorView.Data;
@inject SessionManager manager;
@using LibraryBD.BD;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@using System.Web
@inject ProtectedSessionStorage storage
@inject HttpClient httpclient;
@inject SessionManager sessions;
@inject AuthenticationStateProvider auth;
@inject NavigationManager nav;
@inject IJSRuntime JSRuntime
<style>
    .container-fluid {
        background-color: #ff7300;
    }

    .navbar {
        background-color: #ff7300;
        padding-top: 10px;
    }

    #table {
        border: 1px solid #dddddd;
        border-collapse: collapse;
        width: 100%;
    }

        #table th {
            font-weight: bold;
            padding: 10px;
            background: #efefef;
            border: 1px solid #dddddd;
            text-align: center;
            vertical-align: middle;
        }

        #table td {
            border: 1px solid #dddddd;
            padding: 10px;
            text-align: center;
            vertical-align: middle;
        }

        /* Нечетные строки */
        #table tbody tr:nth-child(odd) {
            background: #fff;
        }

        /* Четные строки */
        #table tbody tr:nth-child(even) {
            background: #F7F7F7;
        }
</style>
<PageTitle>Учёт рабочего времени</PageTitle>
<CascadingAuthenticationState>
    <AuthorizeView>
        <nav class="navbar sticky-top">
            <div class="container-fluid">
                <h5 style="font-size: 130%; margin-top:5px" class="fw-bold text-white">Учёт рабочего времени</h5>
                <div>
                    <label style="color:white; font-weight: bold">С : </label>
                    <input type="date" id="start" name="trip-start" @bind="DateStart" />
                    <label style="color:white; font-weight: bold">По : </label>
                    <input type="date" id="start" name="trip-start" @bind="DateEnd" />
                    <a class="btn btn-success" @onclick="@(() => PostReport())">Экспорт в Excel</a>
                </div>

            </div>
        </nav>
        <table id="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Дата</th>
                    <th>ФИО</th>
                    <th>Должность</th>
                    <th>Начало</th>
                    <th>Конец</th>
                    <th>Наработка</th>

                </tr>
            </thead>

            <tbody>
                @try
                {
                    @foreach (URV urv in ListURV)
                    {
                        <tr>
                            <td>@ListURV.IndexOf(urv)</td>
                            <td>@urv.Date.ToString("dd-MM-yyyy")</td>
                            <td>@urv.FIO</td>
                            <td>@urv.Position</td>
                            <td>@urv.StartTime</td>
                            <td>@urv.EndTime</td>
                            <td>@urv.TotalTime</td>
                        </tr>
                    }
                }
                catch { }
            </tbody>
        </table>
    </AuthorizeView>
</CascadingAuthenticationState>
@code {
    private List<Personal> PersonalList = new();

    private DateTime DateStart = DateTime.Now;
    private DateTime DateEnd = DateTime.Now;
    private DateTime Time = DateTime.Now;

    private int adminListOn = 0;
    private List<URV> ListURV = new();

    private volatile static bool workCycle = new();

    protected override async Task OnAfterRenderAsync(bool firstrender)
    {
        Thread timer = new Thread(() => Timer());
        workCycle = true;
        timer.Start();

        nav.LocationChanged += (obj, lcea) =>
        {
            if (lcea.Location != "http://10.10.1.102:7151/URVPage")
            {
                workCycle = false;
            }
        };

        await base.OnInitializedAsync();
    }

    private async Task PostReport()
    {
        try
        {
            var createReportExcel = await httpclient.PostAsJsonAsync("URV/CreateReportExcel", ListURV);

            if (createReportExcel.IsSuccessStatusCode)
            {
                var baseAdress = nav.BaseUri; // отлавливает базовый ip адрес, чтобы работала загрузка на клиентах вне офисной подсети при обращении через внешний ip
                string url = $"{baseAdress}Учёты рабочего времени/Учёт рабочего времени.xlsx"; 

                await JSRuntime.InvokeVoidAsync("open", url, "_blank");

                // Загрузка файла
                await JSRuntime.InvokeVoidAsync("downloadFile", url);
            }
        }
        catch(Exception ex){}
        
    }

    private async Task Timer()
    {
        while (workCycle == true)
        {
            try
            {
                ListURV = await httpclient.GetFromJsonAsync<List<URV>>($"URV/GetListURV?dateStart={DateStart.ToString("yyyy-MM-dd HH:mm:ss")}&dateEnd={DateEnd.ToString("yyyy-MM-dd HH:mm:ss")}");
                Thread.Sleep(1000);
            }
            catch { }
        }
    }
}
