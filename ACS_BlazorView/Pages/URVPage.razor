                            <td>@offender.Time</td>
                            @if (offender.SendOrNot == 0)
                            {
                                var s = Convert.ToString(offender.SendOrNot);
                                s = "Не отправлено";
                                <td>@s</td>
                            }
                            else
                            {
                                var s = Convert.ToString(offender.SendOrNot);
                                s = "Отправлено";
                                <td>@s</td>
                            }

                        </tr>
                    } *@
                }
                catch { }
            </tbody>
        </table>
    </AuthorizeView>
</CascadingAuthenticationState>
@code {
    private List<Offender> Offenders = new();
    private volatile static bool workCycle = new();
    private DateTime DateFiltr = DateTime.Now;

    protected override async Task OnAfterRenderAsync(bool firstrender)
    {
        Thread timer = new Thread(() => Timer());
        workCycle = true;
        timer.Start();

        nav.LocationChanged += (obj, lcea) =>
        {
            if (lcea.Location != "http://10.10.1.102:7151/OffendersPage")
            {
                workCycle = false;
            }
        };

        await base.OnInitializedAsync();
    }
    private async Task Timer()
    {
        while (workCycle == true)
        {
            try
            {
                //Offenders = await httpclient.GetFromJsonAsync<List<Offender>>($"Offenders/GetOffendersForPage?DateFiltr={DateFiltr.ToString("yyyy-MM-dd HH:mm:ss")}");
                Thread.Sleep(1000);
            }
            catch { }
        }
    }

    private async Task OffendersAll()
    {
        DateFiltr = new();
    }
}
