@page "/URVPage"
@using static ACS_BlazorView.Pages.Index;
@using ACS_BlazorView.Data;
@inject SessionManager manager;
@using LibraryBD.BD;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@inject ProtectedSessionStorage storage
@inject HttpClient httpclient;
@inject SessionManager sessions;
@inject AuthenticationStateProvider auth;
@inject NavigationManager nav;
<style>
    .container-fluid {
        background-color: #ff7300;
    }

    .navbar {
        background-color: #ff7300;
        padding-top: 10px;
    }

    #table {
        border: 1px solid #dddddd;
        border-collapse: collapse;
        width: 100%;
    }

        #table th {
            font-weight: bold;
            padding: 10px;
            background: #efefef;
            border: 1px solid #dddddd;
            text-align: center;
            vertical-align: middle;
        }

        #table td {
            border: 1px solid #dddddd;
            padding: 10px;
            text-align: center;
            vertical-align: middle;
        }

        /* Нечетные строки */
        #table tbody tr:nth-child(odd) {
            background: #fff;
        }

        /* Четные строки */
        #table tbody tr:nth-child(even) {
            background: #F7F7F7;
        }
</style>
<PageTitle>УРВ</PageTitle>
<CascadingAuthenticationState>
    <AuthorizeView>
        <nav class="navbar sticky-top">
            <div class="container-fluid">
                <h5 style="font-size: 130%" class="fw-bold text-white">Учёт рабочего времени</h5>
                <div>
                    <input type="date" id="start" name="trip-start" @bind="DateFiltr" />
                    <a class="btn btn-primary" @onclick="@(() => OffendersAll())">Показать все</a>
                </div>

            </div>
        </nav>
        <table id="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Имя</th>
                    <th>Должность</th>
                    <th>Время на работе</th>
                </tr>
            </thead>

            <tbody>
                @try
                {
                    @* @foreach (Offender offender in @Offenders)
                    {
                        <tr>
                            <td>@Offenders.IndexOf(offender)</td>
                            <td>@offender.Name</td>
                            <td>@offender.Position</td>
