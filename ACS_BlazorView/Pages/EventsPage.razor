@page "/EventsPage"
@using static ACS_BlazorView.Pages.Index;
@using ACS_BlazorView.Data;
@inject SessionManager manager;
@using LibraryBD.BD;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@inject ProtectedSessionStorage storage
@inject HttpClient httpclient;
@inject SessionManager sessions;
@inject AuthenticationStateProvider auth;
@inject NavigationManager nav;
<style>
    .container-fluid {
        background-color: #ff7300;
    }

    .navbar {
        background-color: #ff7300;
        padding-top: 10px;
    }

    #table {
        border: 1px solid #dddddd;
        border-collapse: collapse;
        width: 100%;
    }

        #table th {
            font-weight: bold;
            padding: 10px;
            background: #efefef;
            border: 1px solid #dddddd;
            text-align: center;
            vertical-align: middle;
        }

        #table td {
            border: 1px solid #dddddd;
            padding: 10px;
            text-align: center;
            vertical-align: middle;
        }

        /* Нечетные строки */
        #table tbody tr:nth-child(odd) {
            background: #fff;
        }

        /* Четные строки */
        #table tbody tr:nth-child(even) {
            background: #F7F7F7;
        }
</style>
<PageTitle>События</PageTitle>
<CascadingAuthenticationState>
    <AuthorizeView>
    <nav class="navbar sticky-top">
        <div class="container-fluid">
        <h5 style="font-size: 130%" class="fw-bold text-white">События</h5>
            <button type="button" class="btn btn-primary">Кнопка</button>
        </div>
    </nav>
        <table id="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Имя</th>
                    <th>Должность</th>
                    <th>W26</th>
                    <th>Тип события</th>
                    <th>Направление</th>
                    <th>Точка прохода</th>
                    <th>Время</th>
                </tr>
            </thead>

            <tbody>
                @try
                {
                    @foreach (Event events in @Events)
                    {
                        <tr>
                            <td>@Events.IndexOf(events)</td>
                            <td>@events.Fio</td>
                            <td>@events.Position</td>
                            <td>@events.W26</td>
                            @if (events.PassOrDeny == "PASS")
                            {
                                var s = events.PassOrDeny;
                                s = "Разрешено";
                                <td>@s</td>
                            }
                            else
                            {
                                var s = events.PassOrDeny;
                                s = "Отклонено";
                                <td>@s</td>
                            }
                            @if (events.DirName == "IN")
                            {
                                var s = events.DirName;
                                s = "Вход";
                                <td>@s</td>
                            }
                            else
                            {
                                var s = events.DirName;
                                s = "Выход";
                                <td>@s</td>
                            }
                            @if (events.PointId == 4)
                            {
                                var s = Convert.ToString(events.PointId);
                                s = "Точка 1";
                                <td>@s</td>
                            }
                            @if (events.PointId == 6)
                            {
                                var s = Convert.ToString(events.PointId);
                                s = "Точка 2";
                                <td>@s</td>
                            }
                            @if (events.PointId == 8)
                            {
                                var s = Convert.ToString(events.PointId);
                                s = "Точка 3";
                                <td>@s</td>
                            }
                            <td>@events.Time</td>
                        </tr>
                    }
                }
                catch
                {
                    
                }
            </tbody>
        </table>
    </AuthorizeView>
</CascadingAuthenticationState>
@code {
    private List<Event> Events = new();
    private volatile static bool workCycle = new();

    protected override async Task OnAfterRenderAsync(bool firstrender)
    {
        Thread timer = new Thread(() => Timer());
        workCycle = true;
        timer.Start();

        nav.LocationChanged += (obj, lcea) =>
        {
            if (lcea.Location != "https://10.10.1.7:7151/EventsPage")
            {
                workCycle = false;
            }
        };

        await base.OnInitializedAsync();
    }
    private async Task Timer()
    {
        while (workCycle == true)
        {
            Events = await httpclient.GetFromJsonAsync<List<Event>>("Events/GetListEvents");
            Events.Reverse();
            Thread.Sleep(1000);
        }
    }
}
