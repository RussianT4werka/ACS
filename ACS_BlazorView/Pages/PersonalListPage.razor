@page "/PersonalListPage"
@using static ACS_BlazorView.Pages.Index;
@using ACS_BlazorView.Data;
@inject SessionManager manager;
@using LibraryBD.BD;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@inject ProtectedSessionStorage storage
@inject HttpClient httpclient;
@inject SessionManager sessions;
@inject AuthenticationStateProvider auth;
@inject NavigationManager nav;
<style>
    .container-fluid {
        background-color: #ff7300;
    }

    .navbar {
        background-color: #ff7300;
        padding-top: 10px;
    }

    #table {
        border: 1px solid #dddddd;
        border-collapse: collapse;
        width: 100%;
    }

        #table th {
            font-weight: bold;
            padding: 10px;
            background: #efefef;
            border: 1px solid #dddddd;
            text-align: center;
            vertical-align: middle;
        }

        #table td {
            border: 1px solid #dddddd;
            padding: 10px;
            text-align: center;
            vertical-align: middle;
        }

        /* Нечетные строки */
        #table tbody tr:nth-child(odd) {
            background: #fff;
        }

        /* Четные строки */
        #table tbody tr:nth-child(even) {
            background: #F7F7F7;
        }
</style>
<PageTitle>Персонал</PageTitle>
<CascadingAuthenticationState>
    <AuthorizeView>
        <nav class="navbar sticky-top">
            <div class="container-fluid">
                <h5 style="font-size: 130%" class="fw-bold text-white">Персонал</h5>
                <div>
                    <input class="form-check-input" style="margin-top:9px" type="checkbox" id="flexCheckDefault" @onclick="@(() => TurnOnAdminList(adminListOn))" />
                        <label class="form-check-label" for="flexCheckDefault" style="color:white">Показать администраторов</label>
                    <a class="btn btn-primary" href="/CreatePersonalPage">Добавить сотрудника</a>
                    <a class="btn btn-success" href="/RegistrationPage">Добавить администратора</a>
                </div>
            </div>
        </nav>
        <table id="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>ФИО</th>
                    <th>Отдел</th>
                    <th>Должность</th>
                    <th>Фото</th>
                    <th>W26</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @try
                {
                    @foreach(Personal pers in PersonalList)
                    {
                        <tr>
                            <td>@PersonalList.IndexOf(pers)</td>
                            @if (!string.IsNullOrEmpty(pers.Fio) && pers.Fio != "  ")
                            {
                                <td>@pers.Fio</td>
                            }
                            else
                            {
                                <td>*без имени*</td>
                            }
                            <td>@pers.Department</td>
                            <td>@pers.Position</td>
                            <td>@pers.Image</td>
                            <td>@pers.W26</td>
                            @if (pers.Department != "Охрана" && pers.Position != "Администратор")
                            {
                                <td>
                                    <NavLink href="@($"/EditPersonalPage/{pers.Id}")" class="btn btn-primary">✏️</NavLink>
                                </td>
                                <td>
                                    <a class="btn btn-danger" @onclick="@(() => DeletePers(pers))">🗑️</a>
                                </td>
                            }
                            else{
                                <td/>
                                <td/>
                            }
                            
                        </tr>
                    }
                }
                catch{}
                
            </tbody>
        </table>
        <script>
            
        </script>
    </AuthorizeView>
</CascadingAuthenticationState>
@code {
    private List<Personal> PersonalList = new();
    private volatile static bool workCycle = new();
    private int adminListOn = 0;

    protected override async Task OnAfterRenderAsync(bool firstrender)
    {
        Thread timer = new Thread(() => Timer());
        workCycle = true;
        timer.Start();

        nav.LocationChanged += (obj, lcea) =>
        {
            if (lcea.Location != "http://10.10.1.102:7151/PersonalListPage")
            {
                workCycle = false;
            }
        };

        await base.OnInitializedAsync();
    }

    async Task DeletePers(Personal pers)
    {
        try
        {
            var answer = await httpclient.PostAsJsonAsync("Personals/DelPers", pers);
        }
        catch{}
    }

    async Task TurnOnAdminList(int adminOn)
    {
        if (adminOn == 0)
        {
            adminListOn = 1;
        }
        else if (adminOn == 1)
        {
            adminListOn = 0;
        }
    }

    private async Task Timer()
    {
        while (workCycle == true)
        {
            try
            {
                PersonalList = await httpclient.GetFromJsonAsync<List<Personal>>($"Personals/GetPersonals?adminOn={adminListOn}");
                Thread.Sleep(1000);
            }
            catch{}
        }
    }
}

