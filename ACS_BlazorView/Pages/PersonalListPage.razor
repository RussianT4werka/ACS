@page "/PersonalListPage"
@using static ACS_BlazorView.Pages.Index;
@using ACS_BlazorView.Data;
@inject SessionManager manager;
@using LibraryBD.BD;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@inject ProtectedSessionStorage storage
@inject HttpClient httpclient;
@inject SessionManager sessions;
@inject AuthenticationStateProvider auth;
@inject NavigationManager nav;
<style>
    .container-fluid {
        background-color: #ff7300;
    }

    .navbar {
        background-color: #ff7300;
        padding-top: 10px;
    }
</style>
<PageTitle>Персонал</PageTitle>
<CascadingAuthenticationState>
    <AuthorizeView>
        <nav class="navbar sticky-top">
            <div class="container-fluid">
                <h5 style="font-size: 130%" class="fw-bold text-white">Персонал</h5>
                <button type="button" class="btn btn-primary" href="/CreatePersonalPage">Добавить сотрудника</button>
            </div>
        </nav>
        <table class="table">
            <thead>
                <tr>
                    <th>ФИО</th>
                    <th>Отдел</th>
                    <th>Должность</th>
                    <th>Фото</th>
                    <th>Dec</th>
                    <th>W26</th>
                    <th>Hex</th>
                </tr>
            </thead>

            <tbody>
                @foreach(Personal pers in PersonalList)
                {
                    <tr>
                        <td>@pers.Fio</td>
                        <td>@pers.Department</td>
                        <td>@pers.Position</td>
                        <td>@pers.Image</td>
                        <td>@pers.Dec</td>
                        <td>@pers.W26</td>
                        <td>@pers.Hex</td>
                    </tr>
                }
                
                
            </tbody>
        </table>
    </AuthorizeView>
</CascadingAuthenticationState>
@code {
    private IDisposable registration;
    private List<Personal> PersonalList = new();

    protected override async Task OnAfterRenderAsync(bool firstrender)
    {
        GC.Collect();
        PersonalList = await httpclient.GetFromJsonAsync<List<Personal>>("Personals/GetPersonals");
        /*Thread timer = new Thread(() => Timer());
        timer.Start();*/
        nav.LocationChanged += (obj, lcea) =>
        {
            if (lcea.Location != "https://10.10.1.7:7151/PersonalListPage")
            {
                Console.WriteLine("regwre");
            }
        };

        await base.OnInitializedAsync();
    }
    

    private async Task Timer(object sender, LocationChangedEventArgs args)
    {
        while (true)
        {
            PersonalList = await httpclient.GetFromJsonAsync<List<Personal>>("Personals/GetPersonals");
            Thread.Sleep(1000);
        }
    }
}

