@page "/AboutAdminPage"
@inject NavigationManager nav;
@inject ProtectedSessionStorage storage;
@inject SessionManager manager;
@inject HttpClient httpclient;
@using ACS_API.DTO;
@using ACS_BlazorView.Data;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
<style>
    .ali {
        display:flex;
        margin-top: 5%;
        margin-left: 5%;
    }

    .password {
        width: 300px;
        margin-bottom: 2%;
        position: relative;
    }

    #password-input {
        width: 100%;
        padding: 5px 0;
        height: 30px;
        line-height: 40px;
        text-indent: 10px;
        margin: 0 0 15px 0;
        border-radius: 5px;
        border: 1px solid #999;
        font-size: 18px;
    }

    .password-control {
        position: absolute;
        top: 10px;
        right: 6px;
        display: inline-block;
        width: 20px;
        height: 20px;
        background: url(https://snipp.ru/demo/495/view.svg) 0 0 no-repeat;
    }

    .warning-control {
        position: absolute;
        top: 8px;
        right: -25px;
    }

        .password-control.view {
            background: url(https://snipp.ru/demo/495/no-view.svg) 0 0 no-repeat;
        }

    .container-fluid {
        background-color: #ff7300;
    }

    .navbar {
        background-color: #ff7300;
        padding-top: 10px;
    }

</style>
<PageTitle>Данные об аккаунте</PageTitle>
<CascadingAuthenticationState>
    <AuthorizeView Context="editContext">
        <nav class="navbar sticky-top">
            <div class="container-fluid">
                <h5 style="font-size: 130%; margin-top:5px;" class="fw-bold text-white">Аккаунт</h5>
            </div>
        </nav>
        <EditForm Model="@userData" OnSubmit="EditAdmin">
            <h1 class="ali" style="margin-bottom: 5%">Данные аккаунта</h1>
            <div class="ali container text-left">
                <div class="row align-items-start">
                    <div class="col-lg-6">
                        <h4>Фамилия</h4>
                        <div class="password">
                            <input type="login" class="form-control" placeholder="Введите фамилию" @bind="userData.Surname">
                        </div>
                        <h4>Имя</h4>
                        <div class="password">
                            <input type="login" class="form-control" placeholder="Введите имя" @bind="userData.Name">
                        </div>
                        <h4>Отчество</h4>
                        <div class="password">
                            <input type="login" class="form-control" placeholder="Введите отчество" @bind="userData.Patronymic">
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <h4>Email</h4>
                        <div class="password">
                            <input type="email" class="form-control" placeholder="Введите эл. почту" disabled @bind="userData.Email" id="exampleInputEmail1" aria-describedby="emailHelp">
                        </div>
                        <h4>Логин</h4>
                        <div class="password">
                            <input type="login" class="form-control" id="exampleInputEmail1" @bind="userData.Login" placeholder="Введите логин" />
                        </div>

                        <h4>Пароль</h4>
                        <div class="password">
                            <input type="password" class="form-control"  id="exampleInputPassword1" @bind="userData.Password" placeholder="Измените пароль" name="password">
                            <a style="cursor:pointer" class="password-control" onclick="return show_hide_password(this);"></a>
                            <text style="cursor:default" class="warning-control" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Пароль должен быть: &#013;- длина 8 символов &#013;- 2 буквы в верхнем регистре &#013;- 1 Специальный символ &#013;- 2 цифры (0-9) &#013;- 3 буквы в нижнем регистре">🛈</text>
                        </div>
                        
                    </div>
                    <p>
                        <label style="color: red">@message</label>
                    </p>

                    <p>
                        <button class="btn btn-success" type="submit">Сохранить</button>
                    </p>
                </div>
            </div>
            
            

            
        </EditForm>
    </AuthorizeView>
</CascadingAuthenticationState>
@code {
    UserData userData = new();
    string message = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var session = await storage.GetAsync<string>("session");
            if (session.Success)
            {
                var id = manager.GetUserId(session.Value!);
                userData.Id = id;
                userData = await httpclient.GetFromJsonAsync<UserData>($"Admins/GetAdminInfo?id={id}");
                userData.Password = "";
            }
        }
        catch
        {
            message = "Упс... Что-то пошло не так";
        }

        await base.OnInitializedAsync();
    }

    async Task EditAdmin()
    {
        if (!string.IsNullOrEmpty(userData.Email) || !string.IsNullOrEmpty(userData.Login) || !string.IsNullOrEmpty(userData.Password))
        {
            try
            {
                var answer = await httpclient.PostAsJsonAsync("Admins/EditAdmin", userData);
                if (answer.IsSuccessStatusCode)
                {
                    message = "Данные успешно сохранены";
                }
                else
                {
                    message = await answer.Content.ReadAsStringAsync();
                }
            }
            catch{}
        }
        else
        {
            message = "Поля \"Логин\", \"Email\", \"Пароль\", не должны быть пустым";
        }

    }
}
