@page "/VideoPage"
@using LibraryBD.BD;
@inject HttpClient httpClient;
@inject NavigationManager nav;

<style>
    .container-fluid {
        background-color: #ff7300;
    }

    .navbar {
        background-color: #ff7300;
        padding-top: 10px;
    }
    .cam{
        text-align:left;
        transform: scale(0.2) !important;
        transform-origin: 0px 0px;
        height:1300px;
        width:2065px;
    }
    /*общие настройки сетки*/
    .grid {
        /*рисуем зелёные рамки*/
        border: 5px solid #d1e231;
        width:auto;
        /*подключаем сетку*/
        display: grid;
        /*формируем по 4 одинаковых строки и столбца*/
        grid-template-columns: repeat(@countColumn, 415px);
        grid-template-rows: repeat(@countRow, 262px);
    }

        /*внешний вид ячеек*/
        .grid > * {
            /*фоновый цвет*/
            background-color: #ffbf94;
            /*скругление углов*/
            border-radius: 5px;
            /*расстояние от одной границы ячейки до другой*/
            margin: 1px;
            overflow:hidden;
        }
</style>
<PageTitle>Видеонаблюдение</PageTitle>

<CascadingAuthenticationState>
    <AuthorizeView Context="addContext">
        <nav class="navbar sticky-top">
            <div class="container-fluid">
                <h5 style="font-size: 130%" class="fw-bold text-white">Видеонаблюдение</h5>
                    
                    @* Надо сделать dropdown *@
                    
                    <form class="d-flex" role="search">
                        <input class="form-control me-2" type="search" placeholder="Дайте имя потоку" @bind="VideoStream.Name">
                        <input class="form-control me-2" type="search" placeholder="Ссылка на mjpeg поток" @bind="VideoStream.Link">
                        <a class="btn btn-success" @onclick="@(() => AddStream(VideoStream))">Добавить</a>
                    </form>
                <h7 style="color: white;">@message</h7>
                <div>
                    <a @onclick="@(() => PlusColumn())" class="btn btn-primary">+</a>
                    <a @onclick="@(() => MinusColumn())" class="btn btn-primary">-</a>
                </div>
                

            </div>
        </nav>
        <div class="grid">
            @foreach (VideoStream stream in VideoStreamList)
            {
                <div><img class="cam" src="@stream.Link" /></div>
            }
        </div>      
        </AuthorizeView>
    </CascadingAuthenticationState>
@code {
    public string message { get; set; }
    public List<string> ListAResponse { get; set; } = new();
    private int countColumn = new();
    private int countRow = new();
    VideoStream VideoStream = new();
    private List<VideoStream> VideoStreamList { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        try
        {
            VideoStreamList = await httpClient.GetFromJsonAsync<List<VideoStream>>("VideoStreams/GetVideoStreams");
            countColumn = VideoStreamList.Count();
            if (VideoStreamList.Count <= 4)
            {
                countColumn = 4;
                countRow = 1;
            }
            if (VideoStreamList.Count > 4 && VideoStreamList.Count <= 8)
            {
                countColumn = 4;
                countRow = 2;
            }
            if (VideoStreamList.Count > 8 && VideoStreamList.Count <= 12)
            {
                countColumn = 4;
                countRow = 3;
            }
            if (VideoStreamList.Count > 12 && VideoStreamList.Count <= 16)
            {
                countColumn = 4;
                countRow = 4;
            }
        }
        catch(Exception ex)
        {
            message = ex.ToString();
        }
        await base.OnInitializedAsync();
    }
    async Task PlusColumn()
    {
        if (countColumn <= VideoStreamList.Count())
        {
            countColumn += 1;

        }
    }
    async Task MinusColumn()
    {
        if (countColumn >= VideoStreamList.Count())
        {
            countColumn -= 1;

            if (countColumn < 4 && countColumn < VideoStreamList.Count())
            {
                countRow = 2;
            }
        }

    }
    async Task AddStream(VideoStream stream)
    { 
        if (!string.IsNullOrEmpty(stream.Name) && !string.IsNullOrEmpty(stream.Link))
        {
            VideoStream = new() { Name = stream.Name, Link = stream.Link };
            var answer = await httpClient.PostAsJsonAsync("VideoStreams/AddStream", VideoStream);
            if (answer.IsSuccessStatusCode)
            {
                try
                {
                     nav.NavigateTo($"{nav.Uri}", true);
                }
                catch (Exception ex)
                {
                    message = ex.ToString();
                }
            }
            else
            {
                message = "Что-то пошло не так";
            }
        }
        else
        {
            message = "Заполните все поля";
        }
        
    }
}
