@page "/VideoPage"
@inject HttpClient httpClient


<style>
    .container-fluid {
        background-color: #ff7300;
    }

    .navbar {
        background-color: #ff7300;
        padding-top: 10px;
    }
    .cam{
        text-align:left;
        transform: scale(0.2) !important;
        transform-origin: 0px 0px;
        height:1100px;
        width:1700px;
    }
    /*общие настройки сетки*/
    .grid {
        /*рисуем зелёные рамки*/
        border: 5px solid #d1e231;
        width:auto;
        /*подключаем сетку*/
        display: grid;
        /*формируем по 4 одинаковых строки и столбца*/
        grid-template-columns: repeat(4, 342px);
        grid-template-rows: repeat(3, 222px);
    }

        /*внешний вид ячеек*/
        .grid > * {
            /*фоновый цвет*/
            background-color: #ffbf94;
            /*скругление углов*/
            border-radius: 5px;
            /*расстояние от одной границы ячейки до другой*/
            margin: 1px;
            overflow:hidden;
        }
</style>
