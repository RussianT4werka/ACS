@page "/VideoPage"
@using LibraryBD.BD;
@inject HttpClient httpClient;
@inject NavigationManager nav;

<style>
    .container-fluid {
        background-color: #ff7300;
    }

    .navbar {
        background-color: #ff7300;
        padding-top: 10px;
    }
    .cam{
        text-align:left;
        transform: scale(0.2) !important;
        transform-origin: 0px 0px;
        height:1100px;
        width:2065px;
    }
    /*общие настройки сетки*/
    .grid {
        /*рисуем зелёные рамки*/
        border: 5px solid #d1e231;
        width:auto;
        /*подключаем сетку*/
        display: grid;
        /*формируем по 4 одинаковых строки и столбца*/
        grid-template-columns: repeat(@countColumn, 415px);
        grid-template-rows: repeat(@countRow, 262px);
    }

        /*внешний вид ячеек*/
        .grid > * {
            /*фоновый цвет*/
            background-color: #ffbf94;
            /*скругление углов*/
            border-radius: 5px;
            /*расстояние от одной границы ячейки до другой*/
            margin: 1px;
            overflow:hidden;
        }

    .image-button {
        position: relative;
        display: inline-block;
    }

    .btn-warning{
        position: absolute;
        bottom:1px;
        width: 100%;
    }
    .button-link {
        position: absolute;
        bottom: 1px; /* Adjust as needed */
        left: 50%; /* Adjust as needed */
        transform: translateX(-50%); /* Center the button horizontally */
        background-color: #4CAF50; /* Set the background color */
        color: white; /* Set the text color */
        padding: 10px 20px; /* Add padding to the button */
        text-align: center;
        text-decoration: none;
        border-radius: 5px; /* Add rounded corners */
    }
</style>
<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
<script src="https://code.jquery.com/jquery-3.6.0.js" type="text/javascript"></script>
<PageTitle>Видеонаблюдение</PageTitle>

<CascadingAuthenticationState>
    <AuthorizeView Context="addContext">
        <nav class="navbar sticky-top">
            <div class="container-fluid">
                <h5 style="font-size: 130%" class="fw-bold text-white">Видеонаблюдение</h5>
                    <form class="d-flex" style="align-content:center" role="search">

                    <a class="btn btn-danger" href="/StreamListPage" style="margin-right:1%; width: 70%">Список потоков</a>

                    <div class="btn-group" style="margin-right:1%">
                        <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Сетка
                        </button>
                        <div class="dropdown-menu">
                            <a @onclick="@(() => EditColumn(1))" class="dropdown-item">1 колонка</a>
                            <a @onclick="@(() => EditColumn(2))" class="dropdown-item">2 колонки</a>
                            <a @onclick="@(() => EditColumn(3))" class="dropdown-item">3 колонки</a>
                            <a @onclick="@(() => EditColumn(4))" class="dropdown-item">4 колонки</a>
                        </div>
                    </div>

                    @if(message == null)
                    {
                        <input class="form-control me-2" type="search" placeholder="Дайте имя потоку" @bind="VideoStream.Name">
                        <input class="form-control me-2" style="width:115%" type="search" placeholder="Ссылка на mjpeg поток" @bind="VideoStream.Link">
                        <input class="form-control me-2" style="width:120%" type="search" placeholder="Ссылка на открытие двери" @bind="VideoStream.LinkOpenDoor">
                    }
                    else
                    {
                        <input class="form-control me-2" type="search" placeholder="@message" @bind="VideoStream.Name">
                        <input class="form-control me-2" type="search" placeholder="@message" @bind="VideoStream.Link">
                        <input class="form-control me-2" style="width:120%" type="search" placeholder="Ссылка на открытие двери" @bind="VideoStream.LinkOpenDoor">
                    }  
                        <a class="btn btn-success" @onclick="@(() => AddStream(VideoStream))">Добавить</a>
                    </form>
                

            </div>
        </nav>
        <div class="grid">
            @foreach (VideoStream stream in VideoStreamList)
            {
                <div class="image-button">
                    <img class="cam" title="@stream.Name" src="@stream.Link"/>
                    @if(!string.IsNullOrEmpty(stream.LinkOpenDoor))
                    {
                        <a @onclick="@(() => OpenDoor(stream))" class="btn btn-warning">Открыть</a>
                    }
                    else
                    {
                        <a  class="btn btn-warning disabled">Открыть</a>
                    }
                </div>
            }
        </div>
        </AuthorizeView>
    </CascadingAuthenticationState>
@code {
    public string message { get; set; }
    public List<string> ListAResponse { get; set; } = new();
    private int countColumn = new();
    private int countRow = new();
    VideoStream VideoStream = new();
    private List<VideoStream> VideoStreamList { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        try
        {
            VideoStreamList = await httpClient.GetFromJsonAsync<List<VideoStream>>("VideoStreams/GetVideoStreams");
            if (VideoStreamList.Count <= 4)
            {
                countColumn = 4;
                countRow = 1;
            }
            if (VideoStreamList.Count > 4 && VideoStreamList.Count <= 8)
            {
                countColumn = 4;
                countRow = 2;
            }
            if (VideoStreamList.Count > 8 && VideoStreamList.Count <= 12)
            {
                countColumn = 4;
                countRow = 3;
            }
            if (VideoStreamList.Count > 12 && VideoStreamList.Count <= 16)
            {
                countColumn = 4;
                countRow = 4;
            }
        }
        catch(Exception ex)
        {
            message = ex.ToString();
        }
        await base.OnInitializedAsync();
    }

    async Task EditColumn(int id)
    {
        switch (id)
        {
            case 1:
                countColumn = 1;
                countRow = VideoStreamList.Count;
                break;

            case 2:
                countColumn = 2;
                decimal col2 = VideoStreamList.Count;
                countRow = Convert.ToInt32(Math.Ceiling(col2 / Convert.ToDecimal(2)));
                break;

            case 3:
                countColumn = 3;
                decimal col3 = VideoStreamList.Count;
                countRow = Convert.ToInt32(Math.Ceiling(col3 / Convert.ToDecimal(3)));
                break;

            case 4:
                countColumn = 4;
                decimal col4 = VideoStreamList.Count;
                countRow = Convert.ToInt32(Math.Ceiling(col4 / Convert.ToDecimal(4)));
                break;
        }

    }

    async Task OpenDoor(VideoStream stream)
    {
        try
        {
            var answer = await httpClient.GetAsync($"{stream.LinkOpenDoor}");
        }
        catch
        {
            message = "Что-то пошло не так";
        }

    }

    async Task AddStream(VideoStream stream)
    { 
        if (!string.IsNullOrEmpty(stream.Name) && !string.IsNullOrEmpty(stream.Link))
        {
            VideoStream = new() { Name = stream.Name, Link = stream.Link, LinkOpenDoor = stream.LinkOpenDoor };
            var answer = await httpClient.PostAsJsonAsync("VideoStreams/AddStream", VideoStream);
            if (answer.IsSuccessStatusCode)
            {
                try
                {
                     nav.NavigateTo($"{nav.Uri}", true);
                }
                catch (Exception ex)
                {
                    message = ex.ToString();
                }
            }
            else
            {
                message = "Что-то пошло не так";
            }
        }
        else
        {
            message = "Заполните поле";
        }
        
    }
}
